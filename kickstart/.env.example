# Copy this file to .env and fill in the four values from the speaker's
# slide/handout. Everyone in the room uses the same values -- you're all
# sharing one Cognito app client (see server_template.py for why).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
AWS_REGION=us-east-1

# Leave this as-is unless told otherwise.
MCP_BASE_URL=http://localhost:8000

# Only needed for submit.py (step 7) -- the speaker will give you this URL
# when it's time to go live.
LAUNCHER_BASE_URL=
