# The Launcher this app is an OAuth client of.
LAUNCHER_BASE_URL=https://d32mfyc8mwlp0b.cloudfront.net

# This app's own public URL -- used to build the OAuth redirect_uri.
# Leave as localhost for local dev; Terraform sets this to the real
# CloudFront domain in production.
PUBLIC_BASE_URL=http://localhost:8000

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
PORT=8000
