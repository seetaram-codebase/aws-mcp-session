# Same shared Cognito pool as kickstart/ and server/ -- fill from the
# Terraform/CI job summary.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
AWS_REGION=us-east-1
MCP_BASE_URL=http://localhost:8000

# Everything below is populated automatically in ECS by
# infra/terraform/launcher.tf -- only needed here for local testing.
ECS_CLUSTER_NAME=mcp-demo-cluster
ATTENDEE_IMAGE_URI=
ATTENDEE_TASK_ROLE_ARN=
ECS_EXECUTION_ROLE_ARN=
COGNITO_CLIENT_SECRET_ARN=
ALB_LISTENER_ARN=
ALB_DNS_NAME=
SUBNET_IDS=
ECS_TASKS_SECURITY_GROUP_ID=
VPC_ID=
MAX_ATTENDEE_SERVERS=20
