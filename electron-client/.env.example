# Which MCP server to talk to. OAuth is discovered automatically from the
# server's own metadata -- the client never needs Cognito details directly.
MCP_BASE_URL=http://localhost:8000

# Which Bedrock model reasons about tool calls, and which region to invoke it in.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1

# Optional: the MCP Builder Launcher (see launcher/). When set, the agent
# also gets the submit_server tool -- ask it to build and deploy a new tool
# in chat, review the generated code, and approve before it actually
# provisions anything.
LAUNCHER_BASE_URL=
